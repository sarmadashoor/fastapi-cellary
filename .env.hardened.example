# Security-hardened environment configuration
# Copy to .env.hardened and fill in actual values

# Build information
BUILD_DATE=2025-01-01T00:00:00Z
VCS_REF=main
VERSION=1.0.0

# Database configuration
POSTGRES_DB=fastapi_celery_db
POSTGRES_USER=fastapi_user
POSTGRES_PASSWORD=                    # REQUIRED: Strong password (min 20 chars)
DATABASE_URL=postgresql://fastapi_user:YOUR_PASSWORD@postgres:5432/fastapi_celery_db

# Redis configuration
REDIS_PASSWORD=                       # REQUIRED: Strong password (min 20 chars)
REDIS_APP_PASSWORD=                   # Optional: Separate password for app
REDIS_CELERY_PASSWORD=                # Optional: Separate password for celery
REDIS_MONITOR_PASSWORD=               # Optional: Separate password for monitoring
REDIS_URL=redis://redis:6379/0

# Application security
JWT_SECRET=                           # REQUIRED: Strong secret (min 32 chars)
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ADMIN_PASSWORD=                       # REQUIRED: Admin user password

# Celery configuration
CELERY_CONCURRENCY=4
CELERY_MAX_TASKS_PER_CHILD=1000
CELERY_MAX_MEMORY_PER_CHILD=200000
CELERY_SOFT_TIME_LIMIT=300
CELERY_HARD_TIME_LIMIT=360

# Security settings
PYTHONHASHSEED=random
PYTHONOPTIMIZE=1

# Monitoring (optional)
ENABLE_MONITORING=true

# Development settings (disable in production)
DEBUG=false
DEVELOPMENT_MODE=false