# Security-hardened Celery worker container
# Uses multi-stage build and minimal base image for security

# Build stage
FROM python:3.12-slim as builder

# Set build arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

# Security: Create non-root user for build stage
RUN groupadd -r celery && useradd -r -g celery -s /bin/false -c "Celery user" celery

# Security: Install only essential build packages
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3-dev \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Create virtual environment for isolation
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy and install Python dependencies
COPY docker/celeryworker/requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --upgrade pip setuptools wheel \
    && pip install --no-cache-dir -r /tmp/requirements.txt

# Install security tools
RUN pip install --no-cache-dir \
    bandit \
    safety

# Runtime stage
FROM python:3.12-slim as runtime

# Set build arguments
ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

# Metadata
LABEL maintainer="security@fastapi-celery.com" \
      org.label-schema.build-date=$BUILD_DATE \
      org.label-schema.name="fastapi-celery-worker-hardened" \
      org.label-schema.description="Security-hardened Celery worker" \
      org.label-schema.url="https://github.com/fastapi-celery/worker" \
      org.label-schema.vcs-ref=$VCS_REF \
      org.label-schema.version=$VERSION \
      org.label-schema.schema-version="1.0"

# Security: Install only runtime essentials
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    ca-certificates \
    dumb-init \
    curl \
    clamav \
    clamav-daemon \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# Security: Create application user with minimal privileges
RUN groupadd -r -g 1001 celery \
    && useradd -r -u 1001 -g celery -d /app -s /bin/false -c "Celery user" celery

# Security: Create app directory with correct ownership
RUN mkdir -p /app /app/logs /app/tmp /var/log/celery \
    && chown -R celery:celery /app /var/log/celery

# Copy virtual environment from builder
COPY --from=builder --chown=celery:celery /opt/venv /opt/venv

# Security: Copy application code with correct ownership
COPY --chown=celery:celery backend /app

# Copy hardened startup script
COPY --chown=celery:celery docker/celeryworker/start-hardened.sh /app/start.sh
RUN chmod +x /app/start.sh

# Security: Setup ClamAV for virus scanning
RUN mkdir -p /var/lib/clamav \
    && chown clamav:clamav /var/lib/clamav \
    && chmod 755 /var/lib/clamav

# Initialize ClamAV database (will be updated at runtime)
RUN freshclam --quiet || true

# Security: Set PATH to include venv
ENV PATH="/opt/venv/bin:$PATH"

# Security: Set working directory
WORKDIR /app

# Security: Set security-focused environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONHASHSEED=random \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    C_FORCE_ROOT=1

# Security: Drop privileges and use dumb-init
USER celery
ENTRYPOINT ["dumb-init", "--"]
CMD ["./start.sh"]

# Security: Add health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD celery -A app.celery_app inspect ping || exit 1